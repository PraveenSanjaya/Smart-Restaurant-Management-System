              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Admin JWT token issued\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a(\"string\");",
                  "    pm.expect(json.roles).to.include(\"Admin\");",
                  "    pm.environment.set(\"adminToken\", json.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 - Admin Gets All Tables",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{reservationBaseUrl}}/tables"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns array of tables\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "    pm.expect(json.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
