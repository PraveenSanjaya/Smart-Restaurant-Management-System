    {
      "name": "Smoke - Auth & Tables",
      "item": [
        {
          "name": "1.1 - Valid Customer Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{identityBaseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"QA Customer Test\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"phoneNumber\": \"+1234567890\",\n  \"role\": \"Customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "const email = \"qa.customer.\" + Date.now() + \"@bistro.com\";",
                  "pm.environment.set(\"customerEmail\", email);",
                  "console.log(\"Generated Customer Email: \" + email);",
                  "          "
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response time is under 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "pm.test(\"User response contains valid fields and types\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.userId).to.be.a(\"number\");",
                  "    pm.expect(json.userId).to.be.above(0);",
                  "    pm.expect(json.fullName).to.eql(\"QA Customer Test\");",
                  "    pm.expect(json.email.toLowerCase()).to.eql(pm.environment.get(\"customerEmail\").toLowerCase());",
                  "    pm.expect(json.phoneNumber).to.eql(\"+1234567890\");",
                  "    pm.expect(json.isActive).to.eql(true);",
                  "    pm.expect(json.roles).to.be.an(\"array\");",
                  "    pm.expect(json.roles).to.include(\"Customer\");",
                  "    pm.expect(json.createdAt).to.be.a(\"string\");",
                  "    pm.environment.set(\"customerUserId\", json.userId);",
                  "});",
                  "pm.test(\"Security: Password and hash are never exposed\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.password).to.be.undefined;",
                  "    pm.expect(json.passwordHash).to.be.undefined;",
                  "    pm.expect(json.hash).to.be.undefined;",
                  "});",
                  "          "
                ]
              }
            }
          ]
        },
        {
          "name": "2.1 - Customer Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{identityBaseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains valid JWT token and user info\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a(\"string\");",
                  "    pm.expect(json.token.length).to.be.above(20);",
                  "    pm.expect(json.userId).to.be.a(\"number\");",
                  "    pm.expect(json.email.toLowerCase()).to.eql(pm.environment.get(\"customerEmail\").toLowerCase());",
                  "    pm.expect(json.roles).to.include(\"Customer\");",
                  "    pm.expect(json.expiresAt).to.be.a(\"string\");",
                  "    pm.environment.set(\"customerToken\", json.token);",
                  "    pm.environment.set(\"jwtToken\", json.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 - KitchenStaff Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{identityBaseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{kitchenStaffEmail}}\",\n  \"password\": \"{{kitchenStaffPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"KitchenStaff JWT token issued\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.token).to.be.a(\"string\");",
                  "    pm.expect(json.roles).to.include(\"KitchenStaff\");",
                  "    pm.environment.set(\"kitchenStaffToken\", json.token);",
                  "});"
                ]
              }
            }
          ]
        },
