{
  "stryker-config": {
    "project": "reservation-service.csproj",
    "test-projects": [
      "reservation-service-tests.csproj"
    ],
    "mutate": [
      "**/Models/ReservationStatusTransitionPolicy.cs",
      "**/Models/ReservationOverlapPolicy.cs",
      "**/Models/ReservationStatus.cs",
      "**/Services/AvailabilitySearchValidator.cs",
      "**/Services/ReservationLifecycleService.cs",
      "**/Services/ReservationMaintenancePolicy.cs",
      "**/Services/BookingReferenceGenerator.cs",
      "**/Events/ReservationEventFactory.cs"
    ],
    "mutation-level": "Complete",
    "coverage-analysis": "perTest",
    "ignore-methods": [
      "*Log*",
      "ToString"
    ],
    "reporters": [
      "progress",
      "cleartext",
      "html",
      "json",
      "markdown"
    ],
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 60
    },
    "additional-timeout": 5000
  }
}
