<?xml version="1.0" encoding="utf-8"?>
<!-- SE3112 – Code Quality & Metrics: Coverlet settings shared by every unit-test project. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <!-- Measure production code only. -->
          <Include>[identity-service]*,[reservation-service]*</Include>
          <ExcludeByFile>**/Program.cs,**/obj/**,**/*.g.cs</ExcludeByFile>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
